DEF_DISABLE_ON="Darwin Linux"
DEF_STANDALONE=YES
DEF_FULL_NAME="ZNC - An advanced IRC Bouncer"
DEF_NAME="znc"
DEF_VERSION="1.10.3"
DEF_SHA="bddb815d3159e42f6f556e9888dda424129ad355"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://znc.in/releases/${DEF_NAME}-${DEF_VERSION}.tar.gz"
# DEF_ORIGIN="https://wiki.znc.in/ZNC"
DEF_REQUIREMENTS="pcre openssl icu"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DOPENSSL_ROOT_DIR=${PREFIX} -DWANT_ICU=YES -DWANT_OPENSSL=YES"
DEF_USELESS="lib/*.a include lib/pkgconfig man sbin"
DEF_EXPORTS="znc znc-buildmod"
