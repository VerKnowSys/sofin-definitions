DEF_FULL_NAME="Music Player Daemon Client"
DEF_NAME="mpc"
DEF_SHA="7a43a98142140d6521848cfdb9d35e96ee6aa0ba"
DEF_VERSION="0.35"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://www.musicpd.org/download/${DEF_NAME}/0/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="meson"
DEF_REQUIREMENTS="readline lzo gdbm sqlite pcre perl openssl libxml2 libmpdclient"
# autotools options left out with the switch (no meson option): LIBMPDCLIENT_CFLAGS=-I${PREFIX}/include LIBMPDCLIENT_LIBS='-L${PREFIX} -lmpdclient'
DEF_CONFIGURE_ARGS=""
DEF_EXPORTS="mpc"
