DEF_FULL_NAME="GNU Libtool - The GNU Portable Library Tool"
DEF_NAME="libtool"
DEF_VERSION="2.6.2"
DEF_SHA="4d49bd98639a2f60cb348af1ca5623944141bc22"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://ftp.gnu.org/gnu/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="m4"
DEF_AFTER_INSTALL_METHOD="make_gnu_links"
make_gnu_links () {
    ${TEST_BIN} -L ${PREFIX}/bin/g${DEF_NAME}ize || ${LN_BIN} -s ${PREFIX}/bin/${DEF_NAME}ize ${PREFIX}/bin/g${DEF_NAME}ize
    ${TEST_BIN} -L ${PREFIX}/bin/g${DEF_NAME} || ${LN_BIN} -s ${PREFIX}/bin/${DEF_NAME} ${PREFIX}/bin/g${DEF_NAME}
}
DEF_EXPORTS="${DEF_NAME} g${DEF_NAME} ${DEF_NAME}ize g${DEF_NAME}ize"
DEF_CONFIGURE_ARGS="--disable-static --enable-ltdl-install"
