DEF_FULL_NAME="NetBSD Editline library (libedit)"
DEF_NAME="libedit"
DEF_VERSION="20240808-3.1"
DEF_SHA="37cbf926372fc01f2fcf43cddb4b093676b2843f"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://thrysoee.dk/editline/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_AFTER_INSTALL_METHOD="${LN_BIN} -s ${PREFIX}/include/editline ${PREFIX}/include/readline || :"
DEF_CONFIGURE_ARGS="--disable-static"
