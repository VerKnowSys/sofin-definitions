DEF_STANDALONE=YES
DEF_FULL_NAME="Grafana"
DEF_NAME="grafana"
DEF_VERSION="12.3.0"
DEF_SHA="d0c4c714ddd72905ec06383c4859a54d5c3bfbee"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="@go"
DEF_CONFIGURE_METHOD="ignore"
DEF_EXPORTS="grafana"
DEF_NO_CCACHE=YES

DEF_MAKE_METHOD="make_action"
make_action () {
    mkdir -p "${PREFIX}/bin"
    debug "Patching version under: $(distd "pkg/cmd/grafana-server/main.go")"
    ${SED_BIN} -i '' -e "s|^var version =.*\$|var version = \"${DEF_VERSION}\"|; s|^var buildBranch =.*\$|var buildBranch = \"v${DEF_VERSION}\"|" \
        pkg/cmd/grafana-server/main.go \
        pkg/cmd/grafana-cli/main.go

    run "GOPATH=${PREFIX} go install github.com/google/wire/cmd/wire@v0.7.0"
    run "wire gen -tags oss ./pkg/server ./pkg/cmd/grafana-cli/runner"
    run "go build -ldflags '-w -X main.version=${DEF_VERSION}' -o '${PREFIX}/bin/grafana' ./pkg/cmd/grafana"

    # ORIGIN for the prebuild: https://dl.grafana.com/grafana/release/12.3.0/grafana_12.3.0_19497075765_linux_amd64.tar.gz
    debug "Fetching prebuilt Grafana archive"
    ${FETCH_BIN} -o "${DEF_NAME}_${DEF_VERSION}_linux_amd64.tar.gz" "${MAIN_SOURCE_REPOSITORY}${DEF_NAME}_${DEF_VERSION}_linux_amd64.tar.gz" \
        && ${TAR_BIN} xf "${DEF_NAME}_${DEF_VERSION}_linux_amd64.tar.gz" \
        && cd "${DEF_NAME}-${DEF_VERSION}" \
        && ${CP_BIN} -R public/ "${PREFIX}/public" \
        && ${CP_BIN} -R conf/ "${SERVICE_DIR}/conf" \
        && cd .. \
        && note "Done." \
        && return 0
    return 1
}

DEF_INSTALL_METHOD="strip_wipe_and_link_stuff"
strip_wipe_and_link_stuff () {
    for binary in $(to_iter "${DEF_EXPORTS}"); do
        ${STRIP_BIN} "${PREFIX}/bin/${binary}"
    done
    if [ ! -L "${PREFIX}/conf" ]; then
        ${LN_BIN} -fs "${SERVICE_DIR}/conf" "${PREFIX}/conf"
    fi
    if [ -n "${PREFIX}" ]; then
        ${RM_BIN} -rf \
            "${PREFIX}/api" \
            "${PREFIX}/lib" \
            "${PREFIX}/man" \
            "${PREFIX}/misc" \
            "${PREFIX}/src" \
            "${PREFIX}/pkg" \
            "${PREFIX}/test" \
            "${SERVICE_DIR}/pkg"
    fi
}
