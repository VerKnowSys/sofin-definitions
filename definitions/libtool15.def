DEF_FULL_NAME="GNU Libtool - The GNU Portable Library Tool"
DEF_SHA="4c1738351736562a951a345e24f233d00953ec0a"
DEF_NAME="libtool"
DEF_VERSION="1.5.26"
DEF_SUFFIX="15"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://ftp.gnu.org/gnu/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="m4"
DEF_AFTER_INSTALL_METHOD="${LN_BIN} -s ${PREFIX}/bin/libtoolize ${PREFIX}/bin/glibtoolize || true"
DEF_EXPORTS="libtool libtoolize glibtoolize"
