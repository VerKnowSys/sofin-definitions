DEF_FULL_NAME="Libpcap - a portable C/C++ library for network traffic capture."
DEF_NAME="libpcap"
DEF_VERSION="1.11.0"
DEF_SHA="3ef6e17cf31268356a4573f2d085bde2c4b70c1b"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://www.tcpdump.org/release/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DENABLE_DBUS=no -DENABLE_REMOTE=off -DBDEBUG=off -DPCAP_TYPE=bpf"
