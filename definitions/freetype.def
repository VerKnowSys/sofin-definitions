DEF_FULL_NAME="Freetype - library to render fonts"
DEF_NAME="freetype"
DEF_VERSION="2.14.3"
DEF_SHA="62e26b89a057ad4f1e28af977945d5c1975a8e67"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://download.savannah.gnu.org/releases/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="zlib libpng texinfo brotli"
DEF_CONFIGURE_METHOD="meson"

DEF_AFTER_INSTALL_METHOD="move_libdata_pc"
move_libdata_pc () {
    mv -v "${PREFIX}/libdata/pkgconfig/freetype2.pc" "${PREFIX}/lib/pkgconfig/"
    return 0
}
