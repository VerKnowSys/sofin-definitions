DEF_FULL_NAME="FIDO2 library"
DEF_NAME="libfido2"
DEF_VERSION="1.17.0"
DEF_SHA="503c41ee8131ece6bce3acbfbe1ca84b9498b6b8"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://developers.yubico.com/${DEF_NAME}/Releases/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="openssl libcbor zlib"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DUSE_WINHELLO=OFF -DBUILD_TOOLS=OFF -DBUILD_SHARED_LIBS=ON -DBUILD_STATIC_LIBS=OFF -DBUILD_TESTS=OFF -DBUILD_EXAMPLES=OFF -DNFC_LINUX=OFF"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-14*|FreeBSD-15*)
        unset DEF_USE_LTO
        ;;
esac
