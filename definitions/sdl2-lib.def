DEF_FULL_NAME="SDL2 Library"
DEF_NAME="SDL2"
DEF_SHA="ce98fa93e31836a751feca374ab28a0770b63c16"
DEF_VERSION="2.32.10"
DEF_ORIGIN="https://www.libsdl.org/release/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="m4 perl autoconf libtool automake"
DEF_AFTER_UNPACK_METHOD="./autogen.sh"
DEF_CONFIGURE_ARGS="--enable-ssemath --enable-sse2 --enable-audio --enable-oss --enable-video --enable-libc --enable-render --enable-assembly --enable-cpuinfo --enable-file --enable-loadso --enable-timers --enable-threads --enable-filesystem --enable-power --enable-shared --enable-static --disable-rpath"
