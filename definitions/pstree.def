DEF_DISABLE_ON="Linux"
DEF_FULL_NAME="PStree"
DEF_NAME="pstree"
DEF_SHA="5fe1df1db3f0791afcbc448377d0e2c1081f9e46"
DEF_VERSION="2.40"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/FredHucht/${DEF_NAME}/archive/refs/tags/v${DEF_VERSION}.tar.gz"
DEF_CONFIGURE_METHOD="ignore"
DEF_MAKE_METHOD="true"
DEF_INSTALL_METHOD="install_method"
install_method () {
    ${MKDIR_BIN} -p "${PREFIX}/bin" "${PREFIX}/lib"
    try "${CC_NAME} ${CFLAGS} ${LDFLAGS} -o ${PREFIX}/bin/pstree ${BUILD_DIR}/${DEF_NAME}-${DEF_VERSION}/pstree.c"
}
DEF_EXPORTS="pstree"
