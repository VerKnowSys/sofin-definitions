DEF_FULL_NAME="Reusable library for GPU-accelerated video/image rendering"
DEF_NAME="libplacebo"
DEF_VERSION="7.387.0"
DEF_SHA=""
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
# GitHub mirror of code.videolan.org/videolan/libplacebo (which blocks scripted downloads):
DEF_ORIGIN="https://github.com/haasn/libplacebo/archive/refs/tags/v${DEF_VERSION}.tar.gz"
# Release archives lack the git submodules: fast_float comes from its own
# definition, and the OpenGL (glad) and Vulkan (jinja2, Vulkan SDK) back-ends
# are off.
DEF_REQUIREMENTS="fast_float lcms2 xxhash"
DEF_CONFIGURE_METHOD="meson"
DEF_CONFIGURE_ARGS="-Dbuildtype=release -Dvulkan=disabled -Dopengl=disabled -Dd3d11=disabled -Dglslang=disabled -Dshaderc=disabled -Dlibdovi=disabled -Dunwind=disabled -Ddemos=false -Dtests=false -Dbench=false -Dfuzz=false"
DEF_USE_CXX17=YES
