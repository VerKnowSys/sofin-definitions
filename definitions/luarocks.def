DEF_STANDALONE=YES
DEF_FULL_NAME="Luarocks"
DEF_NAME="luarocks"
DEF_VERSION="3.13.0"
DEF_SHA="48d0e90797ad538911fb476ecfe53be0c077751b"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://luarocks.org/releases/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_USEFUL="bin/lua*"
DEF_REQUIREMENTS="lua53"
DEF_INSTALL_METHOD="make install && make bootstrap"
DEF_EXPORTS="luarocks lua luac luarocks luarocks-admin"

DEF_COMPILER_FLAGS="-DLUA_USE_DLOPEN -DDLUA_USE_POSIX"

DEF_AFTER_UNPACK_METHOD="patch_srcfile"
patch_srcfile () {
    mkdir -p "${SERVICE_DIR}/cache"
    ${SED_BIN} -i '' -e "s|/var/cache|${SERVICE_DIR}/cache|g;" src/luarocks/fs/unix.lua
}
