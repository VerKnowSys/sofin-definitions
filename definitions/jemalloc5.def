DEF_FULL_NAME="Jemalloc Library"
DEF_SHA="1c8f2d0dfbf39fa8cd86363bf3314351ab21f8d4"
DEF_NAME="jemalloc"
DEF_VERSION="5.3.0"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_ORIGIN="https://github.com/jemalloc/${DEF_NAME}/releases/download/${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_REQUIREMENTS="libunwind"
DEF_CONFIGURE_ARGS="--with-jemalloc-prefix=je_ --enable-prof --enable-prof-libunwind --enable-fill --enable-lazy-lock --enable-stats --enable-utrace --enable-xmalloc"
DEF_EXPORTS="jemalloc-config jemalloc.sh"
DEF_MAKE_METHOD="make -s"
