DEF_DISABLE_ON="Linux FreeBSD"
DEF_FULL_NAME="Audacious Core"
DEF_NAME="audacious"
DEF_VERSION="4.5.1"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_SHA="49829c641e2880e5c076b17db7c49980a553358f"
DEF_REQUIREMENTS="@qtbase qtsvg @ffmpeg @glib ${DEF_NAME}-core ${DEF_NAME}-plugins" # qtmacextras
BUILDSTAMP="Sofin-${SOFIN_VERSION} Darwin-${SYSTEM_VERSION} $(date +%Y-%m-%dT%H:%M:%S%z)"
DEF_CONFIGURE_METHOD="meson"
DEF_CONFIGURE_ARGS="-Dbuildtype=release -Ddbus=false -Dgtk=false -Dqt=true -Dbuildstamp=\"${BUILDSTAMP}\""
DEF_COMPILER_FLAGS="-U_LIBCPP_ENABLE_ASSERTIONS"
DEF_USE_CXX17=YES

DEF_AFTER_INSTALL_METHOD="compile_macos_app_bundle"
compile_macos_app_bundle () {
    ${RM_BIN} -rf "${PREFIX}/Audacious.app"
    ${CP_BIN} -r ${BUILD_DIR}/${DEF_NAME}-${DEF_VERSION}/contrib/macpack/Audacious.app ${PREFIX}/

    # the binary itself
    ${CP_BIN} "${PREFIX}/bin/${DEF_NAME}" "${PREFIX}/Audacious.app/Contents/MacOS/${DEF_NAME}"

    # all libraries
    ${CP_BIN} -r "${PREFIX}/lib" "${PREFIX}/Audacious.app/Contents/lib"

    # but remove not required files
    ${RM_BIN} -rf \
        "${PREFIX}/Audacious.app/Contents/lib/cmake" \
        "${PREFIX}/Audacious.app/Contents/lib/gettext" \
        "${PREFIX}/Audacious.app/Contents/lib/libpng" \
        "${PREFIX}/Audacious.app/Contents/lib/objects-Release" \
        "${PREFIX}/Audacious.app/Contents/lib/pkgconfig" \
        "${PREFIX}/Audacious.app/Contents/lib/ckport" \
        ${PREFIX}/Audacious.app/Contents/lib/*.a \
        ${PREFIX}/Audacious.app/Contents/lib/*.prl

    return 0
}

