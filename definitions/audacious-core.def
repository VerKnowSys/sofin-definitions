DEF_DISABLE_ON="Linux FreeBSD"
DEF_FULL_NAME="Audacious Core"
DEF_NAME="audacious"
DEF_VERSION="4.5.1"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_SHA="49829c641e2880e5c076b17db7c49980a553358f"
DEF_REQUIREMENTS="@qtbase qtsvg @ffmpeg @glib ${DEF_NAME}-core ${DEF_NAME}-plugins" # qtmacextras
BUILDSTAMP="Sofin-${SOFIN_VERSION} Darwin-${SYSTEM_VERSION} $(date +%Y-%m-%dT%H:%M:%S%z)"
DEF_CONFIGURE_METHOD="meson"
DEF_CONFIGURE_ARGS="-Dbuildtype=release -Ddbus=false -Dgtk=false -Dqt=true -Dbuildstamp=\"${BUILDSTAMP}\""
DEF_COMPILER_FLAGS="-U_LIBCPP_ENABLE_ASSERTIONS"
DEF_USE_CXX17=YES

DEF_AFTER_INSTALL_METHOD="compile_macos_app_bundle && set_correct_rpath"
compile_macos_app_bundle () {
    ${RM_BIN} -rf "${PREFIX}/Audacious.app"
    ${CP_BIN} -r ${BUILD_DIR}/${DEF_NAME}-${DEF_VERSION}/contrib/macpack/Audacious.app ${PREFIX}/
    (
        cd "${PREFIX}/Audacious.app/Contents/MacOS";
        ${LN_BIN} -fs "${PREFIX}/bin/${DEF_NAME}" "${DEF_NAME}";
    )
    return 0
}

set_correct_rpath () {
    install_name_tool -add_rpath "${PREFIX}/lib" "${PREFIX}/lib/libaudcore.5.dylib"
    install_name_tool -add_rpath "${PREFIX}/lib" "${PREFIX}/bin/${DEF_NAME}"
}
