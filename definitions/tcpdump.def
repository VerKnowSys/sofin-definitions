DEF_FULL_NAME="TCP Dump"
DEF_NAME="tcpdump"
DEF_VERSION="4.99.7"
DEF_SHA="27e086415d2f280292a6780e7bef3a88e7b3ff59"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://www.tcpdump.org/release/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="libpcap openssl"
DEF_CONFIGURE_ARGS="--with-crypto=${PREFIX} --with-pcap=${PREFIX} --disable-smb --without-gcc"
DEF_EXPORTS="${DEF_NAME}"
