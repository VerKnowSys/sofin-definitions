DEF_FULL_NAME="GNU Wget"
DEF_STANDALONE=YES
DEF_NAME="wget"
DEF_VERSION="1.25.0"
DEF_SHA="939b74b0759a2e5f57ec9ac12f5b4403fd9cf5cf"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://ftp.gnu.org/gnu/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="perl libgpg-error gmp nettle libffi libtasn1 p11-kit @gnutls libidn2"
DEF_USELESS="lib/perl* lib/*.{a,la} lib/{pkcs11,pkgconfig} include share/gtk* share/{info,aclocal,libgpg-error,p11-kit} libexec man"
DEF_EXPORTS="${DEF_NAME}"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*)
        unset DEF_USE_LTO
        ;;
esac

# Nettle 4.0 removed the explicit length argument from the *_digest functions:
DEF_AFTER_CONFIGURE_METHOD="sed -i '' 's/nettle_md4_digest(&MD4, MD4_DIGEST_SIZE, ntbuffer)/nettle_md4_digest(\&MD4, ntbuffer)/' src/http-ntlm.c"
