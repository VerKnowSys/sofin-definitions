DEF_DISABLE_ON="Linux FreeBSD"
DEF_FULL_NAME="Helm"
DEF_STANDALONE=YES
DEF_NAME="helm"
DEF_VERSION="3.16.3"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-v${DEF_VERSION}-darwin-arm64.tar.gz"
DEF_TYPE=meta

DEF_EXPORTS="${DEF_NAME}"
DEF_AFTER_INSTALL_METHOD="install_binary"
install_binary () {
    cd /tmp
    rm -f "${DEF_SOURCE_PATH##*/}"
    ${CURL_BIN} -O "${DEF_SOURCE_PATH}"
    tar -xf "${DEF_SOURCE_PATH##*/}"
    mkdir -p "${PREFIX}/bin/"
    run "${CP_BIN} -f darwin-arm64/${DEF_NAME} ${PREFIX}/bin/"
}
