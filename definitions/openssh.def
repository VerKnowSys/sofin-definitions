DEF_FULL_NAME="OpenSSH client with FIDO2 key support"
DEF_NAME="openssh"
DEF_VERSION="10.4p1"
DEF_SHA="ae8650a71cc52dbbd049519cee276ae6d65c2c4d"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_CONFIGURE_ARGS="--with-ssl-engine --with-pid-dir=${SERVICE_DIR} --with-zlib=${PREFIX} --with-ssl-dir=${PREFIX} --with-security-key-builtin --disable-etc-default-login --with-libedit=${PREFIX} --without-shadow"
DEF_REQUIREMENTS="libedit openssl libcbor zlib libfido2"
DEF_USEFUL="libexec"
# install-nokeys: plain "install" runs ./ssh-keygen -A, which writes host keys
# into the bundle (shipped with the binary build), and runs sshd -t in parallel
# with the files being installed.
DEF_INSTALL_METHOD="make ${MAKE_OPTS} install-nokeys SHELL=${SOFIN_UTILS_DIR}/exports/bash"
DEF_EXPORTS="c_rehash scp sftp ssh ssh-add ssh-agent ssh-keygen ssh-keyscan ssh-askpass ssh-sk-helper sftp-server ssh-keysign ssh-pkcs11-helper ssh-sk-helper sshd sshd-session"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    Darwin-*)
        DEF_CONFIGURE_ARGS="${DEF_CONFIGURE_ARGS} --without-rpath"
        ;;
    *)
        # OpenSSH links its programs with LDFLAGS only, so Sofin's rpath (in CFLAGS) is missing.
        DEF_LINKER_FLAGS="${DEF_LINKER_FLAGS} -Wl,-rpath=${PREFIX}/lib"
        ;;
esac
