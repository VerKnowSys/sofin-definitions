DEF_FULL_NAME="Multi-platform support library with a focus on asynchronous I/O"
DEF_NAME="libuv"
DEF_VERSION="1.51.0"
DEF_SHA="9acd1df973a033ae7d20d3b204c7ceefe8707318"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-v${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/${DEF_NAME}/${DEF_NAME}/archive/v${DEF_VERSION}.tar.gz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DLIBUV_BUILD_BENCH=OFF -DLIBUV_BUILD_TESTS=OFF -DBUILD_TESTING=OFF"
