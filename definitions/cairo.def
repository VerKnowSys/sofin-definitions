DEF_FULL_NAME="Cairo graphics library (headless build with support for: SVG, PS, PDF, PNG, JPEG, FC, FT and CairoScript)"
DEF_STANDALONE=YES
DEF_NAME="cairo"
DEF_VERSION="1.18.6"
DEF_SHA="5536e160329129bd43a13238e116272c0e8be85e"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://www.cairographics.org/releases/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="meson"

case "${SYSTEM_NAME}" in
    Darwin)
        # autotools options left out with the switch (no meson option): --disable-full-testing --disable-valgrind --enable-gtk-doc-html=no --enable-test-surfaces=no --enable-directfb=no --enable-trace=no --enable-gl=no --enable-interpreter=yes --enable-script=yes --enable-ft=yes --enable-fc=yes --enable-gobject=yes --enable-pthread=yes --enable-xml=yes --enable-svg=yes --enable-ps=yes --enable-pdf=yes
        DEF_CONFIGURE_ARGS="-Dxlib=disabled -Dsymbol-lookup=disabled"
        ;;

    *)
        # autotools options left out with the switch (no meson option): --disable-full-testing --disable-valgrind --enable-gtk-doc-html=no --enable-test-surfaces=no --enable-directfb=no --enable-trace=no --enable-gl=no --enable-interpreter=yes --enable-script=yes --enable-ft=yes --enable-fc=yes --enable-gobject=yes --enable-pthread=yes --enable-xml=yes --enable-svg=yes --enable-ps=yes --enable-pdf=yes POPPLER_CFLAGS=-I${PREFIX}/include POPPLER_LIBS='-L${PREFIX}/lib -lpoppler -lpoppler-cpp'
        DEF_CONFIGURE_ARGS="-Ddefault_library=shared -Dxlib=disabled -Dsymbol-lookup=disabled"
        ;;
esac
DEF_REQUIREMENTS="@glib icu jpeg jbig2dec jbigkit openjpeg libjpeg-turbo @fontconfig pixman poppler"
DEF_USEFUL="bin/pkg*"
DEF_USELESS="lib/libxslt-plugins libexec ssl man share/man share/bash* share/aclocal* share/auto* share/{bison,doc,gtk-doc,gdb,emacs,examples,info,libtool,gettext,icu,util-macros,t1lib/doc} lib/*.a lib/openjpeg-* lib/*.sh share/glib-* share/gettext-* share/graphite* docs sbin"

DEF_AFTER_INSTALL_METHOD="create_stub_version"
create_stub_version () { # NOTE: FIXME: this wrapper is just a workaround for Sofin that doesn't perform def-useless-cleanup-routine without an exported binary
    _cairo_stub="${PREFIX}/bin/${DEF_NAME}-version"
    printf "%b\n\n%b\n" "#!/bin/sh" "cat \"${PREFIX}/${DEF_NAME}${DEF_SUFFIX}.installed\"" > "${_cairo_stub}"
    try "${CHMOD_BIN} 755 ${_cairo_stub}"
}
DEF_EXPORTS="${DEF_NAME}-version"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*)
        unset DEF_USE_LTO
        ;;
esac
