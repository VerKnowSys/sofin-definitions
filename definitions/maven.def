DEF_FULL_NAME="Apache Maven"
DEF_NAME="maven"
DEF_SHA="a55820cac786c44c329462c7b5591d0a663d53bb"
DEF_VERSION="3.9.16"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}-bin.tar.gz"
DEF_ORIGIN="https://dlcdn.apache.org/${DEF_NAME}/maven-3/${DEF_VERSION}/binaries/apache-maven-${DEF_VERSION}-bin.tar.gz"
DEF_CONFIGURE_METHOD="binary"
DEF_AFTER_UNPACK_METHOD="${CP_BIN} -fR ${BUILD_DIR}/apache-${DEF_NAME}-${DEF_VERSION}/ ${PREFIX}"
DEF_AFTER_INSTALL_METHOD="${FIND_BIN} ${PREFIX} -type f -name '*.dll' -o -name '*.exe' -o -name '*.bat' | ${XARGS_BIN} ${RM_BIN}"
DEF_USEFUL="bin/*.conf"
DEF_EXPORTS="mvn mvnDebug mvnyjp"
