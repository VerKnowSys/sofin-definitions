DEF_FULL_NAME="Jasper JPEG 2000 Library"
DEF_NAME="jasper"
DEF_VERSION="4.2.9"
DEF_SHA="8f248119d52ce3227f8363b7296d8e8bea8801b1"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/jasper-software/${DEF_NAME}/archive/version-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="@libheif"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DJAS_ENABLE_OPENGL=OFF -DJAS_ENABLE_PROGRAMS=ON -DJAS_ENABLE_DOC=OFF -DJAS_ENABLE_CMAKE_PACKAGE_CONFIG=ON -DALLOW_IN_SOURCE_BUILD=ON"
DEF_EXPORTS="cjpeg djpeg jpegtran rdjpgcom wrjpgcom"
