DEF_FULL_NAME="LibLUV - bare libuv bindings for Lua"
DEF_NAME="luv"
DEF_VERSION="1.52.1-0"
DEF_SHA="dddf41807d5fac52c28eb03bd2a6446c8f31f616"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://codeload.github.com/${DEF_NAME}/${DEF_NAME}/tar.gz/refs/tags/v${DEF_VERSION}"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=ON -DWITH_SHARED_LIBUV=ON -DWITH_LUA_ENGINE=LuaJIT -DLUA_BUILD_TYPE=System"
DEF_REQUIREMENTS="libuv luajit"
