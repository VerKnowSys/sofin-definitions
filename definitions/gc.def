DEF_FULL_NAME="A garbage collector for C and C++"
DEF_NAME="gc"
DEF_VERSION="8.2.8"
DEF_SHA="1c8d7bde86aa98df957563982f38c583c2c6707f"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://www.hboehm.info/${DEF_NAME}/${DEF_NAME}_source/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="libatomic_ops"
DEF_CONFIGURE_ARGS="--enable-cplusplus --enable-threads=posix --enable-thread-local-alloc --enable-parallel-mark ATOMIC_OPS_CFLAGS=-I${PREFIX}/include ATOMIC_OPS_LIBS=-L${PREFIX}/lib"
