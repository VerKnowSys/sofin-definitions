DEF_FULL_NAME="Lame Encoder"
DEF_NAME="lame"
DEF_VERSION="4.0"
DEF_SHA="e3630adf399d8917d4da19b96937b7f9b12774ea"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://downloads.sourceforge.net/project/${DEF_NAME}/${DEF_NAME}/${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.gz"
# Since 3.101 the decoder is the external libmpg123 (>= 1.26.0), not the internal mpglib:
DEF_REQUIREMENTS="mpg123"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*|FreeBSD-12*)
        unset DEF_USE_LTO
        ;;

    FreeBSD-14.*|FreeBSD-15.*)
        DEF_LINKER_FLAGS="-Wl,--undefined-version"
        ;;

    Darwin-*)
        DEF_CONFIGURE_ARGS="--enable-static --disable-shared --disable-frontend"
        ;;
esac
