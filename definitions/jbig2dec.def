DEF_FULL_NAME="jbig2dec - decoder implementation of the JBIG2 image compression format"
DEF_NAME="jbig2dec"
DEF_VERSION="0.20"
DEF_SHA="7bad37e56a610666d29c51e82f23fc6b21818c00"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://distfiles.macports.org/jbig2dec/"
DEF_REQUIREMENTS="@libpng"
DEF_CONFIGURE_ARGS="--with-libpng=${PREFIX} --disable-static"
DEF_EXPORTS="jbig2dec"
