DEF_FULL_NAME="Free Implementation of the Unicode Bidirectional Algorithm"
DEF_NAME="fribidi"
DEF_VERSION="1.0.18"
DEF_SHA=""
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
