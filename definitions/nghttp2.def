DEF_FULL_NAME="Http2 Library"
DEF_NAME="nghttp2"
DEF_VERSION="1.71.0"
DEF_SHA="c910b9c2e04403a7b3020cb05e442b0773f0d136"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://github.com/${DEF_NAME}/${DEF_NAME}/releases/download/v${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DENABLE_SHARED_LIB=ON -DWITH_LIBXML2=ON -DWITH_JEMALLOC=ON -DENABLE_THREADS=ON -DENABLE_PYTHON_BINDINGS=OFF -DENABLE_STATIC_LIB=OFF -DENABLE_EXAMPLES=OFF -DENABLE_FAILMALLOC=OFF -DENABLE_DOC=OFF"
DEF_REQUIREMENTS="jemalloc brotli openssl libxml2 libevent"
