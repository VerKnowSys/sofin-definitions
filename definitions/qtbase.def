DEF_FULL_NAME="Qt 6.10 Base Library"
DEF_NAME="qtbase"
DEF_SHA="ae971fd0648e3e0683be8a4c3032c25149d431dc"
DEF_VERSION="6.10.2"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-everywhere-src-${DEF_VERSION}.tar.xz"
DEF_CONFLICTS_WITH="Qt Qtws Qtwk Qtme"
DEF_REQUIREMENTS="openssl @freetype @zstd brotli libjpeg-turbo @libpng @glib libb2 double-conversion @icu" #  @harfbuzz
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DINSTALL_ARCHDATADIR=share/qt -DINSTALL_DATADIR=share/qt -DINSTALL_EXAMPLESDIR=share/qt/examples -DINSTALL_MKSPECSDIR=share/qt/mkspecs -DINSTALL_TESTSDIR=share/qt/tests -DFEATURE_sql_mysql=OFF -DFEATURE_sql_odbc=OFF -DFEATURE_sql_psql=OFF -DFEATURE_openssl_linked=ON -DFEATURE_pkg_config=ON -DFEATURE_system_doubleconversion=ON -DFEATURE_system_freetype=ON  -DFEATURE_system_jpeg=ON -DFEATURE_system_libb2=ON -DFEATURE_system_png=ON -DFEATURE_system_sqlite=ON -DFEATURE_system_zlib=ON -DQT_ALLOW_SYMLINK_IN_PATHS=ON -DFEATURE_relocatable=ON -DCMAKE_STAGING_PREFIX=${PREFIX}  -DQT_NO_APPLE_SDK_AND_XCODE_CHECK=ON -DCMAKE_OSX_DEPLOYMENT_TARGET=14.0 -DQT_USE_CCACHE=ON -Dzstd_DIR=${PREFIX} -Dunofficial-brotli_DIR=${PREFIX}"
DEF_USE_CXX17=YES
DEF_NO_CCACHE=YES
DEF_EXPORTS="qt-cmake qt-cmake-create qt-configure-module qdbuscpp2xml qdbusxml2cpp qtpaths qtpaths6 androiddeployqt androiddeployqt6 androidtestrunner macdeployqt macdeployqt6 qmake qmake6"
