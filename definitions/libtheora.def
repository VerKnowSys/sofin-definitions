DEF_FULL_NAME="Lib Theora"
DEF_NAME="libtheora"
DEF_VERSION="1.2.0"
DEF_SHA="5526a8142784776b3b6f9f9c99aa8d215f54c3b0"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="http://downloads.xiph.org/releases/theora/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="libogg libvorbis"
DEF_CONFIGURE_ARGS="--enable-shared --enable-static=no --disable-examples --disable-sdltest --disable-spec --with-ogg=${PREFIX} --with-vorbis=${PREFIX}"
