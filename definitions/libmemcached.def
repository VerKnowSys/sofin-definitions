DEF_FULL_NAME="Memcached - library only."
DEF_NAME="libmemcached"
DEF_SHA="ba413750cbe972eacceb6f341bb6d6e22358d9c5"
DEF_VERSION="1.2.0"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://launchpad.net/${DEF_NAME}/${DEF_VERSION%.*}/${DEF_VERSION}/+download/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_CONFIGURE_METHOD="cmake"
# autotools options left out with the switch (not for CMake): --enable-libmemcachedprotocol --disable-sasl --without-memcached ac_cv_have_htonll=no --disable-static
DEF_CONFIGURE_ARGS=""

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*|FreeBSD-12*)
        unset DEF_USE_LTO
        ;;
esac
