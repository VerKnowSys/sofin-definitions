DEF_FULL_NAME="A readline wrapper"
DEF_NAME="rlwrap"
DEF_VERSION="0.48"
DEF_SHA="506b284c8f4314cd0456c2baa2aebbf7bb7e14fb"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/hanslub42/rlwrap/releases/tag/v${DEF_VERSION}"
DEF_REQUIREMENTS="@automake readline"
DEF_AFTER_UNPACK_METHOD="after_unpack"
after_unpack () {
    autoreconf -v -i
}
DEF_CONFIGURE_METHOD="autoreconf -fi && ./configure CFLAGS=-I${PREFIX}/include CPPFLAGS=-I${PREFIX}/include LDFLAGS=-L${PREFIX}/lib"
DEF_CONFIGURE_ARGS="--without-libptytty --disable-debug --disable-dependency-tracking --disable-proc-mountpoint"
DEF_EXPORTS="rlwrap"
