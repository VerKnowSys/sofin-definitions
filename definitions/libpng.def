DEF_FULL_NAME="PNG Library (with apng patch for hBSD hosts)"
DEF_NAME="libpng"
DEF_VERSION="1.6.47"
DEF_SHA="457daf5cd6b838e0f9644341ec2d36d53dae6a23"
DEF_CONFIGURE_ARGS="--disable-static --enable-shared --with-sysroot=${PREFIX} --with-zlib-prefix=${PREFIX} CPPFLAGS=-I${PREFIX}/include"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://distfiles.macports.org/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="zlib"
