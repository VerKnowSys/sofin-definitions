DEF_FULL_NAME="PNG Library (with apng patch for hBSD hosts)"
DEF_NAME="libpng"
DEF_VERSION="1.6.55"
DEF_SHA="13f7bedf27009e59961f823cc779a5f9f5341a91"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://distfiles.macports.org/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="zlib"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DPNG_STATIC=OFF -DPNG_TESTS=OFF"
DEF_NO_CCACHE="YES"
DEF_EXPORTS="libpng-config libpng16-config pngfix png-fix-itxt"
