DEF_FULL_NAME="Oniguruma Regexp Library"
DEF_NAME="onig"
DEF_VERSION="6.9.10"
DEF_SHA="bcada943679fa8cecfe359e57d785da9430dcdbc"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/kkos/oniguruma/releases/download/v${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_SHARED_LIBS=ON -DENABLE_POSIX_API=ON -DENABLE_BINARY_COMPATIBLE_POSIX_API=ON -DINSTALL_DOCUMENTATION=OFF -DINSTALL_EXAMPLES=OFF -DCMAKE_INSTALL_NAME_DIR=${PREFIX}/lib"
DEF_NO_TRAP_INT_OVERFLOW=YES
DEF_EXPORTS="onig-config"
