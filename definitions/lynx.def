DEF_FULL_NAME="Lynx"
DEF_STANDALONE=YES
DEF_NAME="lynx"
DEF_VERSION="2.9.3"
DEF_SHA="ff74670dc6112d6c9c301369ade1a1f9ec6286a6"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}${DEF_VERSION}.tar.bz2"
DEF_ORIGIN="https://invisible-mirror.net/archives/${DEF_NAME}/tarballs/lynx${DEF_VERSION}.tar.bz2"
DEF_REQUIREMENTS="zlib libressl-lib"
DEF_CONFIGURE_ARGS="--with-bzlib --with-zlib=${PREFIX} --with-ssl=${PREFIX} --with-mime-libdir=${SERVICE_DIR} --enable-widec --disable-finger --enable-default-colors --enable-underlines --with-screen=ncurses"
DEF_USELESS="lib/*.a include"
DEF_EXPORTS="${DEF_NAME}"
unset DEF_USE_LTO
