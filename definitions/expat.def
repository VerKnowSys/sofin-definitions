DEF_FULL_NAME="Expat Library"
DEF_NAME="expat"
DEF_VERSION="2.11.0"
DEF_SHA="473acf36883e2b24ce003710ad52f5cb001d9604"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_STATIC_LIBS=OFF -DBUILD_SHARED_LIBS=ON"
DEF_EXPORTS="xmlwf"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*|FreeBSD-12*)
        unset DEF_USE_LTO
        ;;

    Darwin-*)
        DEF_CONFIGURE_METHOD="./configure"
        DEF_CONFIGURE_ARGS=""
        ;;
esac
