inherit "python313"

unset DEF_SUFFIX
DEF_FULL_NAME="Meson build system (Python 3.13)"
DEF_VERSION="1.8.2"
DEF_NAME="meson"
DEF_USEFUL="bin/python3* bin/pip*"
DEF_REQUIREMENTS="@python313"
DEF_EXPORTS="${DEF_NAME}"
DEF_TYPE="meta"

DEF_AFTER_INSTALL_METHOD="upgrade_pip && install_meson && install_utils"
upgrade_pip () {
    ${PREFIX}/bin/pip3 install --upgrade pip
}

install_meson () {
    ${PREFIX}/bin/pip3 install ${DEF_NAME}==${DEF_VERSION}
}

install_utils () {
    ${PREFIX}/bin/pip3 install setuptools packaging
}
