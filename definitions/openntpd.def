DEF_STANDALONE=YES
DEF_FULL_NAME="Open-NTPd"
DEF_NAME="openntpd"
DEF_VERSION="7.9p1"
DEF_SHA="5bc3821d54faa830940dcf7732681fb9472084f0"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://cdn.openbsd.org/pub/OpenBSD/OpenNTPD/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="bison"
DEF_CONFIGURE_ARGS="--enable-dependency-tracking --with-cacert=/etc/ssl/cert.pem"
DEF_USELESS="lib/*.{a,la} include"
DEF_EXPORTS="ntpctl ntpd"
