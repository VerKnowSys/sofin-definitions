DEF_FULL_NAME="Git SCM Library"
DEF_NAME="libgit2"
DEF_VERSION="1.9.7"
DEF_SHA="a20d8c9a716fdc43f6564d77cb796f52cda128c4"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://codeload.github.com/${DEF_NAME}/${DEF_NAME}/tar.gz/v${DEF_VERSION}"
DEF_REQUIREMENTS="pcre2 @curl-openssl @libssh2"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_SHARED_LIBS=ON -DUSE_SSH=ON -DUSE_HTTPS=ON -DENABLE_REPRODUCIBLE_BUILDS=ON -DBUILD_TESTS=OFF -DBUILD_EXAMPLES=OFF"
DEF_USELESS="lib/python* doc share include/python*"
DEF_EXPORTS="git2"
