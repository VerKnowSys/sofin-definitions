DEF_FULL_NAME="LibXSLT for LibXML"
DEF_NAME="libxslt"
DEF_VERSION="1.1.45"
DEF_SHA="1963cfecbdc6fc48aeb3a9ed31e026be4cde01c1"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="http://xmlsoft.org/sources/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_REQUIREMENTS="libxml2 libgpg-error libgcrypt"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DLIBXSLT_WITH_XSLT_DEBUG=OFF -DLIBXSLT_WITH_TESTS=OFF -DLIBXSLT_WITH_PYTHON=OFF -DLIBXSLT_WITH_PROFILER=OFF -DLIBXSLT_WITH_DEBUGGER=OFF -DLIBXSLT_WITH_CRYPTO=ON"
