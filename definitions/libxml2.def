DEF_DISABLE_ON="Darwin-10.15"
DEF_FULL_NAME="LibXML2 Library"
DEF_NAME="libxml2"
DEF_VERSION="2.15.4"
DEF_SHA="84922543f46ec847958871ee9413df04412cc7b9"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://download.gnome.org/sources/${DEF_NAME}/${DEF_VERSION%.*}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DLIBXML2_WITH_ZLIB=ON -DLIBXML2_WITH_LZMA=ON -DLIBXML2_WITH_PROGRAMS=ON -DLIBXML2_WITH_THREADS=ON -DLIBXML2_WITH_TESTS=OFF -DLIBXML2_WITH_PYTHON=OFF -DLIBXML2_WITH_DEBUG=OFF -DCMAKE_INSTALL_NAME_DIR=${PREFIX}/lib"
DEF_EXPORTS="xml2-config xmlcatalog xmllint"
