DEF_FULL_NAME="Apache Portable RUntime Utility"
DEF_NAME="apr-util"
DEF_VERSION="1.6.6"
DEF_SHA="dd8ba97107b86bbcaf41644c52a89cd5629b96d3"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_ORIGIN="http://ftp.man.poznan.pl/apache//apr/${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_REQUIREMENTS="libressl-lib db apr expat"
DEF_CONFIGURE_ARGS="--with-apr=${PREFIX} --with-crypto --with-openssl=${PREFIX} --with-berkeley-db=${PREFIX}"
DEF_EXPORTS="apr-1-config apu-1-config"
