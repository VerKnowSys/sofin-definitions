DEF_FULL_NAME="GEOS is a C/C++ library for computational geometry with a focus on algorithms used in geographic information systems (GIS) software."
DEF_NAME="geos"
DEF_VERSION="3.14.1"
DEF_SHA="1c5f3ca6d099fcedf85e030abbe7e3cc91231a55"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_ORIGIN="https://download.osgeo.org/${DEF_NAME}/${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_CONFIGURE_METHOD="cmake"
DEF_CONFIGURE_ARGS="-DBUILD_TESTING=OFF -DUSE_CCACHE=ON"
DEF_EXPORTS="geosop geos-config"
