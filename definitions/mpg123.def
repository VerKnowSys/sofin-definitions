DEF_FULL_NAME="mpg123.org"
DEF_NAME="mpg123"
DEF_VERSION="1.33.7"
DEF_SHA="2922a9bb86f36c5d9082fad9baa3903aaeef7918"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_ORIGIN="https://www.${DEF_NAME}.de/download/${DEF_NAME}-${DEF_VERSION}.tar.bz2"
DEF_EXPORTS="${DEF_NAME} ${DEF_NAME}-id3dump ${DEF_NAME}-strip"

case "${SYSTEM_NAME}-${SYSTEM_VERSION}-${SYSTEM_ARCH}" in
    FreeBSD-14*-arm64)
        unset DEF_USE_LTO
        ;;
esac
