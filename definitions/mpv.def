DEF_FULL_NAME="mpv - command line media player"
DEF_STANDALONE=YES
DEF_NAME="mpv"
DEF_VERSION="0.42.0"
DEF_SHA=""
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/mpv-player/mpv/archive/refs/tags/v${DEF_VERSION}.tar.gz"
# @ffmpeg-lib brings in FFmpeg's own requirements (needs Sofin 7fe4e478: @lists follow inherit).
DEF_REQUIREMENTS="@ffmpeg-lib fast_float lcms2 xxhash libplacebo fribidi @freetype @harfbuzz libass luajit libarchive"
DEF_CONFIGURE_METHOD="meson"
DEF_CONFIGURE_ARGS="-Dbuildtype=release -Dlua=luajit -Dmanpage-build=disabled -Dhtml-build=disabled -Dpdf-build=disabled -Djavascript=disabled -Dlibmpv=true"
DEF_EXPORTS="mpv"
DEF_USELESS="include lib/pkgconfig lib/cmake share/doc share/man"
DEF_TEST_METHOD="mpv --version | ${GREP_BIN} -F 'mpv v${DEF_VERSION}'"
