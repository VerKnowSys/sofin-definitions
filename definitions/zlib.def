DEF_FULL_NAME="Z Library"
DEF_NAME="zlib"
DEF_VERSION="1.4"
DEF_SHA="9167f7402417580334067c8a4d424c4f53a1f39c"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://${DEF_NAME}.net/${DEF_NAME}-${DEF_VERSION}.tar.xz"

case "${SYSTEM_NAME}" in
    Darwin)
        ;;

    *)
        DEF_CONFIGURE_METHOD="cmake"
        ;;
esac

case "${SYSTEM_NAME}-${SYSTEM_VERSION}" in
    FreeBSD-11*|FreeBSD-12*)
        unset DEF_USE_LTO
        ;;
esac
