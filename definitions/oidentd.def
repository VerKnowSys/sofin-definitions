DEF_FULL_NAME="Flexible, RFC 1413 compliant Ident daemon with NAT support"
DEF_SHA="fe3b7800de8749addd9792e58285496cab39440e"
DEF_NAME="oidentd"
DEF_VERSION="3.1.0"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_ORIGIN="https://downloads.sourceforge.net/project/${DEF_NAME}/${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.xz"
DEF_CONFIGURE_ARGS="--disable-masq --disable-nat --disable-ipv6 --disable-libnfct --disable-xdgbdir"
DEF_REQUIREMENTS="bison"
DEF_EXPORTS="oidentd"
