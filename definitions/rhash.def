DEF_DISABLE_ON="Darwin"
DEF_FULL_NAME="RHash (Recursive Hasher) is a console utility for computing and verifying hash sums of files."
DEF_NAME="rhash"
DEF_VERSION="1.4.6"
DEF_SHA="b97afef14dd2a6fe62ab53f5e82fa600862282bf"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}RHash-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://github.com/rhash/RHash/archive/refs/tags/v${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="libressl-lib"
DEF_CONFIGURE_ARGS="--enable-openssl --enable-static"
DEF_EXPORTS="rhash magnet-link tiger-hash gost-hash tth-hash ed2k-link whirlpool-hash sfv-hash has160-hash edonr256-hash edonr512-hash"
