DEF_FULL_NAME="VI MPd Client"
DEF_NAME="vimpc"
DEF_VERSION="0.09.1"
DEF_SHA="b4e9790eaf0a25035ba32c2c98993fd6900a2c42"
DEF_SOURCE_PATH="${MAIN_SOURCE_REPOSITORY}${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_ORIGIN="https://downloads.sourceforge.net/project/${DEF_NAME}/Release%20${DEF_VERSION}/${DEF_NAME}-${DEF_VERSION}.tar.gz"
DEF_REQUIREMENTS="@python314 libevent taglib pcre brotli lz4 zstd libpsl curl-lib libmpdclient @automake pkgconf"
DEF_CONFIGURE_METHOD="./autogen.sh && ./configure"
DEF_CONFIGURE_ARGS="--with-ncurses --enable-taglib=yes --enable-boost=no --enable-lyrics=yes --enable-warnings=no --enable-debug=no --enable-profiler=no --enable-test=no --enable-dependency-tracking --docdir=${PREFIX}/share/doc"
DEF_USEFUL="share/doc"
DEF_EXPORTS="vimpc"
